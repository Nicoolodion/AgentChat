generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String          @id @default(cuid())
  username          String          @unique
  passwordHash      String
  keyDerivationSalt String
  wrappedUserKey    String
  isSystem          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          Session[]
  chats             Chat[]
  agentSessions     AgentSession[]
  emails            UserEmail[]
  mobileTokens      UserMobileToken[]
  mobileTasks       MobileTask[]
  profile           UserProfile?
  customAgents      CustomAgent[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  wrappedUserKey String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Chat {
  id                String          @id @default(cuid())
  userId            String
  encryptedTitle    String
  model             String
  webSearchEnabled  Boolean         @default(false)
  agentModeLocked   Boolean?        // true = agent, false = normal, null = undecided
  // When set, this chat runs under a user-defined Custom Agent (its model +
  // system instructions + default files apply). null = plain model mode.
  customAgentId     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]
  agentSession      AgentSession?
  mobileTasks       MobileTask[]

  @@index([userId, updatedAt])
}

model Message {
  id                    String   @id @default(cuid())
  chatId                String
  role                  String
  encryptedContent      String
  encryptedReasoning    String?
  encryptedReasoningSegments String? // JSON array of MessageSegment[]
  encryptedContentSegments  String? // JSON array of MessageSegment[]
  encryptedToolPayload  String?
  encryptedToolCalls    String?  // JSON array of ChatToolCall[]
  usagePromptTokens     Int?
  usageCompletionTokens Int?
  usageTotalTokens      Int?
  usageCachedTokens     Int?
  energyJoules          Float?
  energyKwh             Float?
  energyDurationSeconds Float?
  providerModel         String?
  ttftMs                Int?
  avgTokensPerSecond    Float?
  createdAt             DateTime @default(now())
  chat                  Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model AgentSession {
  id             String          @id @default(cuid())
  chatId         String          @unique
  userId         String
  status         String          // "idle" | "thinking" | "executing" | "completed" | "error"
  workspacePath  String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?
  errorMessage   String?

  chat           Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolCalls      AgentToolCall[]
  artifacts      AgentArtifact[]
  mobileTasks    MobileTask[]

  @@index([userId])
  @@index([chatId])
  @@index([status])
}

model AgentToolCall {
  id          String   @id @default(cuid())
  sessionId   String
  toolName    String
  arguments   String   // JSON string
  result      String?  // JSON string
  error       String?
  durationMs  Int?
  status      String   // "pending" | "running" | "success" | "error"
  createdAt   DateTime @default(now())
  completedAt DateTime?

  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model AgentArtifact {
  id          String   @id @default(cuid())
  sessionId   String
  fileName    String
  mimeType    String
  size        Int      // bytes
  kind        String   // "document" | "pdf" | "image" | "code" | "spreadsheet" | "presentation" | "archive" | "other"
  storagePath String   // Relative path within workspace
  description String?
  createdAt   DateTime @default(now())

  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model RateLimitBucket {
  key      String   @id
  count    Int      @default(0)
  resetAt  DateTime

  @@index([resetAt])
}

// ── Mobile Task Launcher / Email-reply feature ───────────────────────────────

model UserEmail {
  id            String    @id @default(cuid())
  userId        String    @unique
  address       String    @unique
  verifiedAt    DateTime?
  verifyToken   String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verifyToken])
}

model UserMobileToken {
  id                  String   @id @default(cuid())
  userId              String
  tokenHash           String   @unique
  wrappedUserKeyCipher String
  installId           String
  label               String?
  ntfyTopic           String
  ntfyAuth            String?
  lastSeenAt          DateTime @default(now())
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MobileTask {
  id                  String    @id @default(cuid())
  userId              String
  agentSessionId      String?
  chatId              String?
  source              String
  prompt              String
  model               String?
  status              String
  emailAddress        String?
  emailMessageId      String?
  emailThreadId       String?
  answeredFromDesktop Boolean   @default(false)
  createdAt           DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  errorMessage        String?
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentSession        AgentSession?   @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
  chat                Chat?           @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@index([emailThreadId])
}

model UserProfile {
  userId    String   @id
  country   String?
  language  String?
  timezone String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MailboxState {
  id          String   @id @default("singleton")
  lastSeenUid Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ── Custom Agents ─────────────────────────────────────────────────────────────
// A user-defined agent preset: a name, extra system-prompt instructions, a
// model to use, and a set of "default files" that are automatically injected
// into every chat bound to this agent (text/image content inlined directly;
// other file types staged via the normal attachment pipeline). Scoped to the
// owning user today, but the userId field keeps it ready for multi-user.

model CustomAgent {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  description          String?
  // Extra instructions appended to the base default system prompt.
  systemPrompt         String
  model                String
  // JSON array of uploaded attachment ids to inject automatically.
  defaultAttachmentIds String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
